# FastAPI application settings
APP_NAME=CUET Lost and Found Box API
APP_ENV=development
DEBUG=true

# Comma-separated browser origins permitted to call the local API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase project URL. It is used to derive the expected token issuer and
# default JWKS endpoint for FastAPI token validation in the auth phase.
SUPABASE_URL=

# Legacy HS256 projects may provide this secret. Prefer JWKS validation for
# current Supabase projects and never expose this value to the frontend.
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated

# PostgreSQL connection string from Supabase. Keep it server-only.
DATABASE_URL=
