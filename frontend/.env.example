# URL used by the browser for FastAPI requests in local development.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase project URL and publishable/anon key. These two values are designed
# to be available to browser code; Row Level Security must protect all data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
